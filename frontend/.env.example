# Production URL example. EAS production profiles already configure this URL.
# EXPO_PUBLIC_BACKEND_URL=https://firefeast-backend.onrender.com

# Local development normally needs no API variable: when this line is omitted,
# Fire Feast derives Metro's host from Expo runtime metadata and uses port 8000.
# To override discovery explicitly, uncomment and set your current backend host:
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional Expo CLI optimization; this value is not exposed to application code.
EXPO_USE_FAST_RESOLVER=1
