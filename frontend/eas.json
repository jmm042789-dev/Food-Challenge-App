{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://firefeast-backend.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://firefeast-backend.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-diagnostic": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_BURNOUT_TIMELINE_DIAGNOSTICS": "1"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://firefeast-backend.onrender.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_BACKEND_URL": "https://fire-feast-api-staging.onrender.com"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    }
  }
}
