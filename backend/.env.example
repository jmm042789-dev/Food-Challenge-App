# Required. Copy to your local environment; this file is not loaded
# automatically and must never contain production secrets.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=fire_feast
FIRE_FEAST_ENV=development
# Optional. Native clients do not require CORS. Browser origins must be
# comma-separated; production origins must use HTTPS.
FIRE_FEAST_CORS_ORIGINS=
# Optional bootstrap credential-recovery window (60-3600 seconds).
FIRE_FEAST_GUEST_RECOVERY_WINDOW_SECONDS=600
